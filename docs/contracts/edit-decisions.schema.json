{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline edit decisions v1 (normal speed, half-open source frames)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "timeline", "sources", "edits"],
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "timeline": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "width", "height", "fps", "start_frame"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "string", "pattern": "^[0-9]+(/[0-9]+)?$"},
        "start_frame": {"type": "integer", "minimum": 0}
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "fps", "frame_count"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "fps": {"type": "string", "pattern": "^[0-9]+(/[0-9]+)?$"},
          "frame_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "edits": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source_id", "in_frame", "out_frame", "record_frame", "track_kind", "track_index", "story_beat", "reason", "evidence", "confidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "in_frame": {"type": "integer", "minimum": 0},
          "out_frame": {"type": "integer", "minimum": 1},
          "record_frame": {"type": "integer", "minimum": 0},
          "track_kind": {"type": "string", "enum": ["video", "audio"]},
          "track_index": {"type": "integer", "minimum": 1},
          "story_beat": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    }
  }
}
