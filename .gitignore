__pycache__/
*.py[cod]
.venv/
# AutoHarness (installed in .venv) writes its audit log to the cwd on every `autoharness check`
audit.jsonl
.env
.env.*
*.db
*.db-wal
*.db-shm
*.drp
!backups/
*.drt
*.mp4
*.mov
renders/
footage/

# Working artifacts: keep on disk, not in the skill bundle
reference/
/scratch/
exports/
.agents/teamwork/
.hermes/
.pytest_cache/
*.tmp
qc_stills/
crop_*.jpg
temp_frame.jpg
pair*.txt
.worktrees/

# Throwaway agent scripts (promote to scripts/ + INDEX.md if reusable)
scripts/scratch/*
!scripts/scratch/.gitkeep

# Project DB copies stay on disk as local rollback points, not in git (large, contain project data)
backups/**/*.sqlite

# Highlight pipeline (scripts/highlight): heavy per-job artifacts stay on disk only
work/highlight/**/audio/
work/highlight/**/frames/
work/highlight/**/transcripts/
work/highlight/**/scores/
work/highlight/**/proxy/
work/highlight/**/review/source_previews/
# reading packs and their briefs are regenerated from transcripts (pipeline.py readpacks/readbriefs)
work/highlight/**/review/*-read-[0-9][0-9].md
work/highlight/**/review/*-read-[0-9][0-9].brief.md
work/highlight/**/*.log
scripts/highlight/.venv/
